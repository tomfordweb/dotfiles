#!/usr/bin/env python3
"""claude-secret-shape-guard — PostToolUse hook.

Shouts when a tool result carries something shaped like a live credential.

Why a PostToolUse hook and not a redactor: by the time a hook runs, the tool
result is already on its way into the transcript. Nothing here can unsee it.
What it CAN do is make the leak loud instead of silent — the failure mode that
produced this hook (dotfiles-3fc: a Google Cloud copy button whose aria-label
held the full OAuth client secret) was invisible until hours later, and a leak
nobody mentions is a leak nobody rotates.

Exit 2 + stderr feeds the message back to the agent as context. The tool has
already run, so nothing is blocked; the agent is told to surface the leak to the
human and rotate the credential.

The message names the pattern and a count. It never echoes the match — a guard
that repeats the secret to complain about it has leaked it a second time.

Patterns are assembled from split literals on purpose: this file would otherwise
match itself the moment anyone reads it, and a guard that cries wolf over its own
source gets switched off.
"""
import json
import re
import sys

# (label, compiled pattern). Prefixes are split so this file is not its own
# tripwire. Lengths are the vendors' real token lengths — long enough that
# ordinary prose and base64-looking build output do not match.
PATTERNS = [
    ("Google OAuth client secret", "GOCSP" + "X-[A-Za-z0-9_-]{20,}"),
    ("Anthropic/OpenAI-style key", "sk" + "-[A-Za-z0-9_-]{32,}"),
    ("GitHub token", "gh[pousr]" + "_[A-Za-z0-9]{36,}"),
    ("GitHub fine-grained PAT", "github" + "_pat_[A-Za-z0-9_]{50,}"),
    ("GitLab PAT", "glp" + "at-[A-Za-z0-9_-]{20,}"),
    ("AWS access key id", "AKI" + "A[0-9A-Z]{16}"),
    ("Slack token", "xox" + "[abprs]-[A-Za-z0-9-]{20,}"),
    ("Resend API key", "re" + "_[A-Za-z0-9]{24,}"),
    ("Google API key", "AIz" + "a[0-9A-Za-z_-]{35}"),
    ("npm token", "npm" + "_[A-Za-z0-9]{36}"),
    ("DigitalOcean token", "dop" + "_v1_[a-f0-9]{64}"),
    ("private key block", "-----BEGIN [A-Z ]*PRIVATE KEY-----"),
]
COMPILED = [(label, re.compile(pattern)) for label, pattern in PATTERNS]


def walk(value):
    """Yield every string in an arbitrarily nested tool_response."""
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from walk(item)
    elif isinstance(value, list):
        for item in value:
            yield from walk(item)


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0  # malformed payload is not this hook's problem

    haystack = "\n".join(walk(payload.get("tool_response")))
    if not haystack:
        return 0

    hits = []
    for label, pattern in COMPILED:
        count = len(pattern.findall(haystack))
        if count:
            hits.append(f"{label} (x{count})" if count > 1 else label)
    if not hits:
        return 0

    tool = payload.get("tool_name") or "a tool"
    print(
        "claude-secret-shape-guard: credential-shaped output from "
        f"{tool} — {', '.join(hits)}.\n"
        "This is already in the transcript and cannot be unsent. Do both halves "
        "now: tell the human plainly which credential leaked and where, and "
        "rotate it (create the replacement, then DELETE the old one). Do not "
        "repeat the value while doing it.\n"
        "If this is a false positive (an example, a test fixture, a public "
        "identifier), say so in one line and carry on.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
