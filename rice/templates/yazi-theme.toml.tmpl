# GENERATED by bin/rice-build. Edit rice/templates/yazi-theme.toml.tmpl
# and rice/palette.json, then rebuild.

[mgr]
cwd = { fg = "#{{accent-secondary}}", bold = true }
border_symbol = "┃"
border_style = { fg = "#{{surface2}}" }

# Only the current directory gets the bright selection bar.
# Explicitly disable Yazi's default reverse/underline styles when merging.
[indicator]
current = { fg = "#{{base}}", bg = "#{{accent-primary}}", bold = true, reversed = false }
parent = { fg = "#{{subtext0}}", bg = "#{{mantle2}}", bold = false, reversed = false }
preview = { fg = "#{{subtext0}}", bg = "#{{mantle2}}", bold = false, underline = false, reversed = false }
padding = { open = "█", close = "█" }

[tabs]
active = { fg = "#{{base}}", bg = "#{{accent-primary}}", bold = true }
inactive = { fg = "#{{subtext0}}", bg = "#{{mantle2}}", bold = false }
