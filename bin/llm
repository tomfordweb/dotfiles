#!/usr/bin/env python3
"""Portable model registry, runtime launcher, and OpenAI-compatible client."""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


RUNTIMES = {
    "llama": {"url": "http://127.0.0.1:18080/v1", "command": ["llama-server"],
              "formats": ["gguf"], "docs": "https://github.com/ggml-org/llama.cpp/tree/master/tools/server"},
    "ollama": {"url": "http://127.0.0.1:11434/v1", "command": ["ollama"],
               "formats": ["ollama"], "docs": "https://docs.ollama.com"},
    "vllm": {"url": "http://127.0.0.1:18081/v1", "command": ["vllm"],
             "formats": ["hf"], "docs": "https://docs.vllm.ai/en/stable/cli/serve/"},
    "sglang": {"url": "http://127.0.0.1:18082/v1", "command": ["sglang"],
               "formats": ["hf"], "docs": "https://docs.sglang.io/docs/get-started/quickstart"},
    "tabby": {"url": "http://127.0.0.1:18083/v1", "command": [],
              "formats": ["exl3"], "docs": "https://github.com/theroyallab/tabbyAPI"},
    "lmstudio": {"url": "http://127.0.0.1:1234/v1", "command": ["lms"],
                 "formats": ["endpoint"], "docs": "https://lmstudio.ai/docs/developer/core/headless"},
}


def config_path():
    return Path(os.environ.get("LLM_CONFIG", str(Path(os.environ.get(
        "XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "llm/config.json")))


def load_config():
    path = config_path()
    config = json.loads(path.read_text()) if path.exists() else {"version": 1, "models": {}, "runtimes": {}}
    if not isinstance(config, dict) or config.get("version") != 1 or not isinstance(config.get("models"), dict) or not isinstance(config.get("runtimes"), dict):
        raise ValueError(f"Invalid registry: {path} (expected version 1, models and runtimes objects)")
    return config


@contextlib.contextmanager
def edit_config():
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        config = load_config()
        yield config
        fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".config-")
        try:
            with os.fdopen(fd, "w") as output:
                json.dump(config, output, indent=2)
                output.write("\n")
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def runtime_config(config, name):
    if name not in RUNTIMES and name not in config["runtimes"]:
        raise ValueError(f"Unknown runtime: {name}")
    runtime = {**RUNTIMES.get(name, {"formats": ["endpoint"], "command": []}),
               **config["runtimes"].get(name, {})}
    parsed = urllib.parse.urlsplit(runtime.get("url", ""))
    if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError(f"Invalid API URL for {name}; use http(s)://host:port/v1 without credentials")
    runtime["url"] = runtime["url"].rstrip("/")
    command = runtime.get("command", [])
    if not isinstance(command, list) or not all(isinstance(arg, str) for arg in command):
        raise ValueError(f"Runtime {name}: command must be an argv array")
    return runtime


def model_config(config, name):
    if name not in config["models"]:
        raise ValueError(f"Unknown model: {name}. Use llm add or llm scan --register.")
    model = config["models"][name]
    runtime = runtime_config(config, model["runtime"])
    return model, runtime


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def http(runtime, path, body=None, timeout=30):
    headers = {"Content-Type": "application/json"}
    key_env = runtime.get("api_key_env")
    if key_env:
        if not os.environ.get(key_env):
            raise ValueError(f"Set {key_env} for this endpoint")
        headers["Authorization"] = "Bearer " + os.environ[key_env]
    request = urllib.request.Request(runtime["url"] + path,
                                     data=None if body is None else json.dumps(body).encode(), headers=headers)
    try:
        return urllib.request.build_opener(NoRedirects()).open(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        # Response bodies can echo prompts or credentials. Report status only.
        error.close()
        raise ValueError(f"API HTTP {error.code} {error.reason} at {runtime['url']}{path}") from None


def request_json(runtime, path, body=None, timeout=30):
    with http(runtime, path, body, timeout) as response:
        result = json.load(response)
    if isinstance(result, dict) and result.get("error"):
        raise ValueError("API returned an error response")
    return result


def gguf_shards(source):
    path = Path(source).expanduser()
    match = re.fullmatch(r"(.+)-(\d{5})-of-(\d{5})\.gguf", path.name)
    if not match:
        return [path]
    stem, shard, total = match.groups()
    if int(shard) != 1:
        raise ValueError("Register the first GGUF shard (00001), not a later shard")
    if int(total) < 1:
        raise ValueError("Invalid GGUF shard count")
    shards = [path.with_name(f"{stem}-{index:05d}-of-{total}.gguf")
              for index in range(1, int(total) + 1)]
    if any(not shard.is_file() for shard in shards):
        raise ValueError(f"Incomplete split GGUF: {path}")
    return shards


def scan(args):
    roots = args.roots or [os.environ.get("LLM_MODELS_DIR", "/var/lib/llama-models"),
                           str(Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "llama-models")]
    files = sorted({str(path.resolve()) for root in roots for path in Path(root).expanduser().rglob("*.gguf")
                    if path.is_file() and ".cache" not in path.parts})
    print(f"Models ({len(files)}):", file=sys.stderr)
    for path in files:
        print(path, file=sys.stderr)
    if args.register:
        with edit_config() as config:
            known = {m["source"] for m in config["models"].values()}
            for path in files:
                match = re.search(r"-(\d{5})-of-\d{5}\.gguf$", path)
                if match and match[1] != "00001":
                    continue
                if path in known:
                    continue
                stem = re.sub(r"[^a-z0-9-]+", "-", Path(path).stem.lower()).strip("-") or "model"
                alias, suffix = stem, 1
                while alias in config["models"]:
                    alias = f"{stem}-{hashlib.sha256(path.encode()).hexdigest()[:8]}-{suffix}"
                    suffix += 1
                config["models"][alias] = {"source": path, "format": "gguf", "runtime": "llama", "model": alias}
                known.add(path)
    print(json.dumps(files, indent=2))


def doctor(config, args):
    results = []
    for name in sorted(set(RUNTIMES) | set(config["runtimes"])):
        runtime = runtime_config(config, name)
        command = runtime["command"]
        available = bool(command and shutil.which(command[0]))
        status = "not checked"
        if args.probe:
            try:
                data = request_json(runtime, "/models", timeout=2)
                status = f"online ({len(data.get('data', []))} models)"
            except (OSError, ValueError):
                status = "offline or unauthorized"
        results.append({"runtime": name, "installed": available, "endpoint": runtime["url"],
                        "status": status, "formats": runtime["formats"], "docs": runtime.get("docs")})
    print(json.dumps(results, indent=2))


def serve_command(name, model, runtime, args):
    kind = model["runtime"]
    if kind not in ("llama", "vllm", "sglang", "tabby"):
        raise ValueError("Start this runtime with its own service, then use llm chat. See llm doctor.")
    if model["format"] not in runtime["formats"]:
        raise ValueError(f"{kind} accepts {runtime['formats']}, not {model['format']}")
    if kind != "llama" and not args.gpu:
        raise ValueError(f"{kind} requires --gpu; llama supports CPU by default")
    source = model["source"]
    if model["format"] != "hf" or source.startswith(("/", ".", "~")):
        source = str(Path(source).expanduser().resolve(strict=True))
    address = urllib.parse.urlsplit(runtime["url"])
    if address.hostname not in ("127.0.0.1", "localhost", "::1"):
        raise ValueError("Managed servers must bind loopback. Use an external service for remote endpoints.")
    port = address.port or (443 if address.scheme == "https" else 80)
    if address.scheme != "http" or address.path != "/v1":
        raise ValueError("Managed servers need an http://loopback:port/v1 URL")
    command = list(runtime["command"])
    if not command:
        raise ValueError("Configure runtime command argv first (Tabby needs its own virtualenv and main.py)")
    common = ["--host", address.hostname, "--port", str(port)]
    if kind == "llama":
        command += ["--model", source, "--alias", model.get("model", name), "--ctx-size", str(args.context),
                    "--n-gpu-layers", str(args.gpu_layers if args.gpu else 0), "--parallel", "1"] + common
    elif kind == "vllm":
        command += ["serve", source, "--served-model-name", model.get("model", name),
                    "--max-model-len", str(args.context), "--gpu-memory-utilization", "0.75",
                    "--max-num-seqs", "1"] + common
    elif kind == "sglang":
        command += ["serve", source, "--served-model-name", model.get("model", name),
                    "--context-length", str(args.context), "--mem-fraction-static", "0.75",
                    "--max-running-requests", "1"] + common
    else:
        path = Path(source)
        command += ["--model-dir", str(path.parent), "--model-name", path.name,
                    "--max-seq-len", str(args.context)] + common
    command += runtime.get("args", []) + model.get("args", [])
    return command, address.hostname, port


@contextlib.contextmanager
def gpu_lock():
    root = Path(os.environ.get("XDG_RUNTIME_DIR", str(Path.home() / ".cache"))) / "llm"
    root.mkdir(parents=True, exist_ok=True)
    with (root / "gpu.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("Another managed runtime owns GPU lock") from None
        yield lock.fileno()


def gpu_preflight(model, config):
    ollama = runtime_config(config, "ollama").copy()
    ollama["url"] = ollama["url"].removesuffix("/v1")
    try:
        loaded = request_json(ollama, "/api/ps", timeout=2).get("models", [])
    except urllib.error.URLError:
        loaded = []
    if loaded:
        raise ValueError("Ollama has loaded models. Run ollama ps, then ollama stop MODEL before --gpu.")
    if not shutil.which("nvidia-smi"):
        raise ValueError("nvidia-smi unavailable; cannot check NVIDIA memory")
    query = subprocess.check_output(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"], text=True)
    free = int(query.splitlines()[0]) * 1024 * 1024
    # A lower bound only: context, backend workspaces and architecture still matter.
    if model["format"] == "gguf" and sum(path.stat().st_size for path in gguf_shards(model["source"])) + 2 * 1024**3 > free:
        raise ValueError("Weights plus 2 GiB reserve exceed free VRAM. Use CPU or a smaller quant/model.")


def serve(config, args):
    model, runtime = model_config(config, args.model)
    command, host, port = serve_command(args.model, model, runtime, args)
    print(shlex.join(command), flush=True)
    if args.dry_run:
        return
    if not shutil.which(command[0]):
        raise ValueError(f"Missing executable: {command[0]}. See llm doctor for install documentation.")
    with socket.socket(socket.AF_INET6 if ":" in host else socket.AF_INET) as check:
        check.bind((host, port))
    # Lock CPU servers too: caller-supplied runtime args may enable offload.
    with gpu_lock() as lock_fd:
        if args.gpu:
            if model["runtime"] == "llama":
                devices = subprocess.check_output(runtime["command"] + ["--list-devices"], text=True, timeout=10)
                if "cuda" not in devices.lower():
                    raise ValueError("llama.cpp launcher has no CUDA device. Install a CUDA build or use CPU.")
            gpu_preflight(model, config)
        child = subprocess.Popen(command, start_new_session=True, cwd=runtime.get("cwd"), pass_fds=(lock_fd,))
        previous = {}
        def forward(signum, _frame):
            if child.poll() is None:
                os.killpg(child.pid, signum)
        for signum in (signal.SIGTERM, signal.SIGINT):
            previous[signum] = signal.signal(signum, forward)
        try:
            code = child.wait()
        finally:
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
            for signum, handler in previous.items():
                signal.signal(signum, handler)
        if code:
            raise ValueError(f"Runtime exited with status {code}")


def completion_body(model, args):
    overrides = json.loads(Path(args.request).read_text()) if args.request else {}
    if not isinstance(overrides, dict):
        raise ValueError("Request file must contain a JSON object")
    body = {**model.get("request_defaults", {}), **overrides}
    if not isinstance(body, dict):
        raise ValueError("Request file must contain a JSON object")
    if "messages" not in body:
        prompt = args.prompt if args.prompt is not None else (sys.stdin.read() if not sys.stdin.isatty() else "")
        if args.input:
            prompt += "\n\n" + Path(args.input).read_text()
        if not prompt.strip():
            raise ValueError("Supply a prompt, piped text, --input, or --request with messages")
        body["messages"] = ([{"role": "system", "content": args.system}] if args.system else [])
        body["messages"].append({"role": "user", "content": prompt})
    body["model"] = model.get("model", args.model)
    for key, fallback in (("max_tokens", 256), ("temperature", 0)):
        value = getattr(args, key)
        if value is not None:
            body[key] = value
        else:
            body.setdefault(key, fallback)
    if args.json:
        body["response_format"] = {"type": "json_object"}
    if args.schema:
        body["response_format"] = {"type": "json_schema", "json_schema": {
            "name": "response", "strict": True, "schema": json.loads(Path(args.schema).read_text())}}
    return body


def stream_completion(runtime, body, timeout):
    body = {**body, "stream": True, "stream_options": {"include_usage": True}}
    started = time.perf_counter()
    first = None
    usage = {}
    finished = False
    with http(runtime, "/chat/completions", body, timeout) as response:
        event = []
        for line in response:
            line = line.decode("utf-8").rstrip("\r\n")
            if line.startswith("data:"):
                event.append(line[5:].lstrip())
            elif not line and event:
                data = "\n".join(event)
                event = []
                if data == "[DONE]":
                    finished = True
                    break
                chunk = json.loads(data)
                if chunk.get("error"):
                    raise ValueError("API returned a streaming error")
                usage = chunk.get("usage") or usage
                for choice in chunk.get("choices", []):
                    delta = choice.get("delta", {})
                    if first is None and any(delta.get(k) for k in ("content", "reasoning_content", "reasoning", "tool_calls")):
                        first = time.perf_counter()
                    if choice.get("finish_reason"):
                        finished = True
    elapsed = time.perf_counter() - started
    if not finished:
        raise ValueError("Incomplete SSE response (no finish reason or [DONE])")
    return {"seconds": elapsed, "ttft_seconds": first - started if first is not None else None,
            "usage": usage,
            "completion_tokens_per_second": usage["completion_tokens"] / elapsed
            if usage.get("completion_tokens") is not None else None}


def infer(config, args):
    model, runtime = model_config(config, args.model)
    body = completion_body(model, args)
    if model["runtime"] == "llama":
        available = request_json(runtime, "/models", timeout=5)
        if body["model"] not in [entry.get("id") for entry in available.get("data", [])]:
            raise ValueError(f"Requested model is not exposed by llama.cpp. Start llm serve {args.model} first.")
    if args.action == "bench":
        print(f"Benchmark target: {args.model}; warmups={args.warmup}, measured={args.runs}", file=sys.stderr)
        for _ in range(args.warmup):
            stream_completion(runtime, body, args.timeout)
        results = [stream_completion(runtime, body, args.timeout) for _ in range(args.runs)]
        report = {"model": args.model, "runtime": model["runtime"], "url": runtime["url"],
                  "max_tokens": body["max_tokens"], "temperature": body["temperature"],
                  "prompt_sha256": hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest(),
                  "warmups": args.warmup, "runs": results,
                  "note": "Throughput includes prefill and request latency; TTFT includes reasoning. No quality score."}
        print(json.dumps(report, indent=2))
        if args.output:
            Path(args.output).write_text(json.dumps(report, indent=2) + "\n")
        return
    body["stream"] = False
    result = request_json(runtime, "/chat/completions", body, args.timeout)
    if args.raw:
        print(json.dumps(result, indent=2))
    else:
        message = result["choices"][0]["message"]
        if message.get("tool_calls"):
            print(json.dumps(message, indent=2))
        else:
            if not message.get("content"):
                raise ValueError("Response has no final text. Use --raw to inspect reasoning/refusal, or increase --max-tokens.")
            print(message.get("content") or "")


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def parser():
    cli = argparse.ArgumentParser(description=__doc__)
    commands = cli.add_subparsers(dest="action", required=True)
    commands.add_parser("init", help="create user registry without replacing existing settings")
    commands.add_parser("list", help="list registered models as JSON")
    check = commands.add_parser("doctor", help="check runtime binaries and optionally API endpoints")
    check.add_argument("--probe", action="store_true")
    discover = commands.add_parser("scan", help="discover local GGUF files")
    discover.add_argument("roots", nargs="*")
    discover.add_argument("--register", action="store_true")
    add = commands.add_parser("add", help="register a GGUF, HF repo/directory, EXL directory, or served model ID")
    add.add_argument("name")
    add.add_argument("source")
    add.add_argument("--runtime", default="llama")
    add.add_argument("--format", choices=["gguf", "hf", "exl3", "ollama", "endpoint"], default="gguf")
    add.add_argument("--served-name", help="API model ID if different from registry alias")
    add.add_argument("--request-defaults", default="{}", help="JSON object of model-specific request defaults")
    endpoint = commands.add_parser("endpoint", help="configure a runtime API URL and optional bearer-key environment variable")
    endpoint.add_argument("name")
    endpoint.add_argument("url")
    endpoint.add_argument("--key-env")
    configure = commands.add_parser("runtime", help="configure a runtime launcher without a shell command")
    configure.add_argument("name", choices=sorted(RUNTIMES))
    configure.add_argument("--command", required=True, help='JSON argv, e.g. ["/path/venv/bin/vllm"]')
    configure.add_argument("--args", default="[]", help="JSON array of extra server arguments")
    configure.add_argument("--cwd", help="working directory, useful for a Tabby checkout")
    launch = commands.add_parser("serve", help="run one local server in foreground; Ctrl-C stops it")
    launch.add_argument("model")
    launch.add_argument("--context", type=positive, default=4096)
    launch.add_argument("--gpu", action="store_true")
    launch.add_argument("--gpu-layers", type=positive, default=999)
    launch.add_argument("--dry-run", action="store_true")
    for action in ("chat", "bench"):
        request = commands.add_parser(action, help="send a chat request" if action == "chat" else "measure streaming TTFT and end-to-end throughput")
        request.add_argument("model")
        request.add_argument("prompt", nargs="?")
        request.add_argument("--input", help="append a UTF-8 file to the prompt")
        request.add_argument("--system")
        request.add_argument("--request", help="JSON request file, including messages/tools/multimodal content")
        structured = request.add_mutually_exclusive_group()
        structured.add_argument("--json", action="store_true", help="request JSON object output")
        structured.add_argument("--schema", help="JSON Schema file")
        request.add_argument("--max-tokens", type=positive, help="generation limit (default: 256 unless request/model sets it)")
        request.add_argument("--temperature", type=float, help="sampling temperature (default: 0 unless request/model sets it)")
        request.add_argument("--timeout", type=positive, default=300)
        if action == "chat":
            request.add_argument("--raw", action="store_true", help="print full response, including reasoning/tool calls")
        else:
            request.add_argument("--runs", type=positive, default=3)
            request.add_argument("--warmup", type=int, choices=range(0, 4), default=1)
            request.add_argument("--output", help="save benchmark report JSON (contains no prompt text)")
    embed = commands.add_parser("embed", help="request embeddings from a compatible model endpoint")
    embed.add_argument("model")
    embed.add_argument("text", nargs="?")
    embed.add_argument("--timeout", type=positive, default=300)
    for name in ("pull", "backup"):
        helper = commands.add_parser(name, help=f"forward arguments to {'llm-pull' if name == 'pull' else 'backup-llm-models'}")
        if name == "backup":
            helper.add_argument("--dry-run", action="store_true")
            helper.add_argument("--verify", action="store_true")
        helper.add_argument("arguments", nargs=argparse.REMAINDER)
    return cli


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        config = load_config()
        if args.action == "init":
            with edit_config():
                pass
            print(config_path())
        elif args.action == "list":
            print(json.dumps(config["models"], indent=2))
        elif args.action == "scan":
            scan(args)
        elif args.action == "doctor":
            doctor(config, args)
        elif args.action == "endpoint":
            with edit_config() as editable:
                editable["runtimes"].setdefault(args.name, {}).update({"url": args.url})
                if args.key_env:
                    editable["runtimes"][args.name]["api_key_env"] = args.key_env
                runtime_config(editable, args.name)
        elif args.action == "runtime":
            command, extra = json.loads(args.command), json.loads(args.args)
            if not command or not all(isinstance(values, list) and all(isinstance(value, str) for value in values)
                                      for values in (command, extra)):
                raise ValueError("command and args must be JSON argv arrays, with a nonempty command")
            with edit_config() as editable:
                entry = editable["runtimes"].setdefault(args.name, {})
                entry.update({"command": command, "args": extra})
                if args.cwd:
                    entry["cwd"] = str(Path(args.cwd).expanduser().resolve(strict=True))
        elif args.action == "add":
            if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", args.name):
                raise ValueError("Alias must start with a letter/digit and contain only letters, digits, _, . or -")
            runtime = runtime_config(config, args.runtime)
            if args.format not in runtime["formats"]:
                raise ValueError(f"{args.runtime} accepts {runtime['formats']}, not {args.format}")
            source = args.source
            if args.format == "hf" and (source.startswith(("/", ".", "~")) or Path(source).expanduser().exists()):
                path = Path(source).expanduser().resolve(strict=True)
                if not path.is_dir():
                    raise ValueError("Local HF source must be a model directory")
                source = str(path)
            if args.format in ("gguf", "exl3"):
                path = Path(source).expanduser().resolve(strict=True)
                if args.format == "gguf" and (not path.is_file() or path.suffix.lower() != ".gguf"):
                    raise ValueError("GGUF source must be a .gguf file")
                if args.format.startswith("exl") and not path.is_dir():
                    raise ValueError("EXL source must be a model directory")
                source = str(path)
            with edit_config() as editable:
                defaults = json.loads(args.request_defaults)
                if not isinstance(defaults, dict):
                    raise ValueError("request-defaults must be a JSON object")
                editable["models"][args.name] = {"source": source, "format": args.format, "runtime": args.runtime,
                                                   "request_defaults": defaults,
                                                   "model": args.served_name or (source if args.format in ("ollama", "endpoint") else
                                                                               Path(source).name if args.runtime == "tabby" else args.name)}
        elif args.action == "serve":
            serve(config, args)
        elif args.action in ("chat", "bench"):
            infer(config, args)
        elif args.action == "embed":
            model, runtime = model_config(config, args.model)
            content = args.text if args.text is not None else (sys.stdin.read() if not sys.stdin.isatty() else "")
            if not content.strip():
                raise ValueError("Supply text or pipe UTF-8 input")
            print(json.dumps(request_json(runtime, "/embeddings", {
                "model": model.get("model", args.model), "input": content}, args.timeout), indent=2))
        else:
            helper = "llm-pull" if args.action == "pull" else "backup-llm-models"
            nearby = Path(__file__).resolve().with_name(helper)
            executable = str(nearby) if nearby.is_file() else shutil.which(helper)
            if not executable:
                raise ValueError(f"Install {helper} or run llm from the dotfiles bin directory")
            arguments = args.arguments[1:] if args.arguments[:1] == ["--"] else args.arguments
            if args.action == "backup":
                arguments = (["--dry-run"] if args.dry_run else []) + (["--verify"] if args.verify else []) + arguments
            environment = dict(os.environ)
            if args.action == "pull" and "LLM_MODELS_DIR" not in environment and not os.access("/var/lib/llama-models", os.W_OK):
                environment["LLM_MODELS_DIR"] = str(Path(environment.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "llama-models")
            return subprocess.call([executable, *arguments], env=environment)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"llm: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
