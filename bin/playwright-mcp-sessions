#!/usr/bin/env bash
# Move logins from the persistent playwright-login profile into the storage
# state file the isolated playwright server hands to every agent.
#
#   playwright-mcp-sessions export     write profile cookies -> storage-state.json
#   playwright-mcp-sessions show       what is in the state file right now
#   playwright-mcp-sessions token set  paste the token the extension shows you
#   playwright-mcp-sessions token      print the stored token
#
# The extension issues the token and displays it in its own page, with a rotate
# button. We are the side that has to match it, so `token set` reads the value
# from a prompt rather than an argument: an argument would land in shell history
# and in the process list. Rotating in the extension means running `token set`
# again and reconnecting the MCP server.
#
# Why this exists: the agent-facing server runs --isolated, which takes no
# profile lock and so allows any number of agents at once. Isolated contexts do
# not write back, so a login has to be performed once in the persistent profile
# (via the playwright-login MCP server, or `playwright-mcp-sessions login`) and
# then exported here.
set -uo pipefail

STATE_DIR="${PLAYWRIGHT_MCP_STATE_DIR:-$HOME/.local/state/playwright-mcp}"
PROFILE="$STATE_DIR/profile"
STATE_FILE="$STATE_DIR/storage-state.json"
TOKEN_FILE="$STATE_DIR/extension-token"
MCP_HOME="${TOMFORDWEB_MCP_HOME:-$HOME/.local/share/tomfordweb-mcp}"

die() { echo "playwright-mcp-sessions: $*" >&2; exit 1; }

chrome_path() {
  # Same browser the MCP servers use. PLAYWRIGHT_CHROMIUM_EXECUTABLE is exported
  # by the shell profile; fall back to globbing the browsers path so this works
  # from a non-interactive shell (cron, a hook, an agent).
  if [ -n "${PLAYWRIGHT_CHROMIUM_EXECUTABLE:-}" ]; then
    echo "$PLAYWRIGHT_CHROMIUM_EXECUTABLE"; return
  fi
  if [ -n "${PLAYWRIGHT_BROWSERS_PATH:-}" ]; then
    # shellcheck disable=SC2086
    echo $(echo "$PLAYWRIGHT_BROWSERS_PATH"/chromium-*/chrome-linux64/chrome | head -1); return
  fi
  die "no chromium found: set PLAYWRIGHT_CHROMIUM_EXECUTABLE"
}

cmd_export() {
  [ -d "$PROFILE" ] || die "no login profile at $PROFILE"
  local chrome; chrome="$(chrome_path)"
  # Launch headless against the profile purely to read its cookie jar out.
  # Fails loudly if the profile is locked, which means a browser is still open
  # on it: close that first rather than exporting a half-written jar.
  PW_PROFILE="$PROFILE" PW_STATE="$STATE_FILE" PW_CHROME="$chrome" node --input-type=module -e '
    const { chromium } = await import(process.env.PW_CORE);
    const ctx = await chromium.launchPersistentContext(process.env.PW_PROFILE, {
      executablePath: process.env.PW_CHROME,
      headless: true,
    });
    const state = await ctx.storageState({ path: process.env.PW_STATE });
    console.log(`exported ${state.cookies.length} cookies from ${state.origins.length} origins`);
    await ctx.close();
  ' || die "export failed (is a browser still open on the profile?)"
  echo "wrote $STATE_FILE"
}

cmd_show() {
  [ -f "$STATE_FILE" ] || die "no state file at $STATE_FILE"
  PW_STATE="$STATE_FILE" node --input-type=module -e '
    import { readFileSync } from "node:fs";
    const s = JSON.parse(readFileSync(process.env.PW_STATE, "utf8"));
    const domains = [...new Set((s.cookies ?? []).map(c => c.domain))].sort();
    console.log(`${(s.cookies ?? []).length} cookies across ${domains.length} domains`);
    for (const d of domains) console.log(`  ${d}`);
  '
}

cmd_login() {
  local chrome; chrome="$(chrome_path)"
  echo "Opening the login profile. Sign in to whatever the agents need, then close the window."
  "$chrome" --user-data-dir="$PROFILE" "$@" >/dev/null 2>&1
  echo "Now run: playwright-mcp-sessions export"
}

cmd_token() {
  if [ "${1:-}" = "set" ]; then
    # -s so the value never appears on screen, and read-from-prompt so it never
    # appears in shell history or in ps output.
    local value
    printf 'Paste the token from the Playwright extension page: ' >&2
    read -rs value
    printf '\n' >&2
    [ -n "$value" ] || die "empty token, nothing written"
    ( umask 077; printf %s "$value" > "$TOKEN_FILE" ) || die "could not write $TOKEN_FILE"
    echo "stored in $TOKEN_FILE"
    echo "Now re-register so the server picks it up:"
    echo "  home-manager switch   (or nixos-rebuild switch)"
    echo "then reconnect the playwright-personal MCP server."
    return
  fi
  [ -s "$TOKEN_FILE" ] || die "no token stored yet: run 'playwright-mcp-sessions token set'"
  cat "$TOKEN_FILE"
}

export PW_CORE="$MCP_HOME/node_modules/playwright-core/index.mjs"
[ -f "${PW_CORE#file://}" ] || die "playwright-core not found at $PW_CORE"

case "${1:-}" in
  export) shift; cmd_export "$@" ;;
  show)   shift; cmd_show "$@" ;;
  login)  shift; cmd_login "$@" ;;
  token)  shift; cmd_token "$@" ;;
  *)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
