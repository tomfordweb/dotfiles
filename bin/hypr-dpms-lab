#!/bin/sh
# hypr-dpms-lab — run a DPMS off/on cycle inside a THROWAWAY Hyprland session.
#
# WHY: on 2026-11-07 `hyprctl dispatch 'hl.dsp.dpms("off")'` killed Hyprland
# 0.56.0 twice (driver 615.78.08), silently: no crash report, no coredump, no
# kernel Xid, and the compositor's own log in $XDG_RUNTIME_DIR was gone after
# the reboot. Testing the blank by hand on the live desktop means losing the
# desktop when it fails. This script runs the same blank in a second Hyprland
# on a spare TTY, with a minimal config and no clients, and keeps every log.
#
# USE: switch to a text console (Ctrl+Alt+F3), log in, run
#
#     hypr-dpms-lab                               # current Hyprland, bare, dispatch
#     hypr-dpms-lab --launcher start-hyprland     # same, through the watchdog
#     hypr-dpms-lab --bin /nix/store/...-hyprland-0.57.1/bin/Hyprland
#     hypr-dpms-lab --blank wlopm                 # wlr-output-power-management path
#
# then switch back to the desktop (Ctrl+Alt+F2) and read
# ~/.local/state/hypr-dpms-lab/<run>/result.txt. The desktop session is only
# VT-switched away while the lab runs; if the lab compositor dies, only the
# lab dies. A driver-level GPU wedge is the one failure this cannot contain.
#
# `--verify` only checks that the generated config parses with the chosen
# binary; safe to run from inside the live session.
#
# Monitor rules are copied from config/hypr/configs/minerva.lua at run time so
# the lab drives the same outputs at the same modes as production.

set -u

bin=""
launcher=bare
blank=dispatch
hold=10
verify=0
dotfiles="$HOME/code/tomfordweb/dotfiles"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-dpms-lab"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    cat <<EOF

Flags:
  --bin PATH          Hyprland binary (default: Hyprland from PATH)
  --launcher MODE     bare | start-hyprland (default: bare)
  --blank MODE        dispatch | wlopm (default: dispatch)
  --hold SECS         seconds to stay blanked (default: 10)
  --verify            only run --verify-config on the generated lab config
EOF
}

die() {
    echo "hypr-dpms-lab: $*" >&2
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --bin)      bin="$2"; shift 2 ;;
        --launcher) launcher="$2"; shift 2 ;;
        --blank)    blank="$2"; shift 2 ;;
        --hold)     hold="$2"; shift 2 ;;
        --verify)   verify=1; shift ;;
        -h|--help)  usage; exit 0 ;;
        *)          die "unknown argument: $1 (try --help)" ;;
    esac
done

case "$launcher" in bare|start-hyprland) ;; *) die "--launcher must be bare or start-hyprland" ;; esac
case "$blank" in dispatch|wlopm) ;; *) die "--blank must be dispatch or wlopm" ;; esac

[ -n "$bin" ] || bin=$(command -v Hyprland) || die "Hyprland not on PATH, pass --bin"
[ -x "$bin" ] || die "not executable: $bin"
bindir=$(dirname "$(readlink -f "$bin")")
hyprctl="$bindir/hyprctl"
[ -x "$hyprctl" ] || hyprctl=$(command -v hyprctl) || die "hyprctl not found"
command -v jq >/dev/null 2>&1 || die "jq not found"

monitors_lua="$dotfiles/config/hypr/configs/minerva.lua"
[ -r "$monitors_lua" ] || die "cannot read $monitors_lua"

blank_cmd=""
case "$blank" in
    dispatch)
        blank_cmd="$hyprctl dispatch 'hl.dsp.dpms(\"off\")'"
        ;;
    wlopm)
        wlopm=$(command -v wlopm 2>/dev/null) || {
            echo "hypr-dpms-lab: wlopm not on PATH, fetching nixpkgs#wlopm" >&2
            out=$(nix build --no-link --print-out-paths nixpkgs#wlopm) || die "nix build wlopm failed"
            wlopm="$out/bin/wlopm"
        }
        blank_cmd="$wlopm --off '*'"
        ;;
esac

run_id=$(date +%Y%m%d-%H%M%S)-$$-$launcher-$blank
run="$state_root/$run_id"
mkdir -p "$run" || die "cannot create $run"

version=$("$bin" --version 2>/dev/null | head -1)
{
    echo "run:      $run_id"
    echo "bin:      $bin"
    echo "version:  $version"
    echo "launcher: $launcher"
    echo "blank:    $blank_cmd"
    echo "hold:     ${hold}s"
    echo "tty:      $(tty 2>/dev/null)"
    echo "driver:   $(cat /sys/module/nvidia/version 2>/dev/null || echo n/a)"
    echo "kernel:   $(uname -r)"
} > "$run/meta.txt"

# --- probe: runs INSIDE the lab compositor, so hyprctl talks to it ----------
cat > "$run/probe.sh" <<EOF
#!/bin/sh
# Generated by hypr-dpms-lab for run $run_id. Runs inside the lab Hyprland.
set -u
run="$run"
hyprctl="$hyprctl"
log() { echo "\$(date +%H:%M:%S.%N | cut -c1-12) \$*" >> "\$run/probe.log"; }

echo "\${HYPRLAND_INSTANCE_SIGNATURE:-}" > "\$run/sig"
log "probe start, sig=\${HYPRLAND_INSTANCE_SIGNATURE:-?}"
sleep 5
"\$hyprctl" monitors -j > "\$run/before.json" 2>>"\$run/probe.log"
log "before: \$(jq -c '[.[]|{name,dpmsStatus}]' "\$run/before.json" 2>/dev/null)"

log "blank: $blank_cmd"
$blank_cmd >> "\$run/probe.log" 2>&1
log "blank returned \$?"
sleep $hold
"\$hyprctl" monitors -j > "\$run/during.json" 2>>"\$run/probe.log"
log "during: \$(jq -c '[.[]|{name,dpmsStatus}]' "\$run/during.json" 2>/dev/null)"

log "unblank: hl.dsp.dpms(\"on\")"
"\$hyprctl" dispatch 'hl.dsp.dpms("on")' >> "\$run/probe.log" 2>&1
log "unblank returned \$?"
sleep 5
"\$hyprctl" monitors -j > "\$run/after.json" 2>>"\$run/probe.log"
log "after: \$(jq -c '[.[]|{name,dpmsStatus}]' "\$run/after.json" 2>/dev/null)"

log "exit"
"\$hyprctl" dispatch 'hl.dsp.exit()' >> "\$run/probe.log" 2>&1
EOF
chmod +x "$run/probe.sh"

# --- lab config: production monitor rules, dpms wake-on-input, one probe -----
{
    echo "-- Generated by hypr-dpms-lab for run $run_id. Throwaway."
    echo "-- Monitor rules copied from $monitors_lua"
    grep '^hl.monitor(' "$monitors_lua"
    cat <<EOF

hl.config({
    misc = {
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        force_default_wallpaper  = 0,
        background_color         = 0xff101010,
        mouse_move_enables_dpms  = true,
        key_press_enables_dpms   = true,
    },
})

hl.on("hyprland.start", function()
    hl.exec_cmd("$run/probe.sh")
end)
EOF
} > "$run/lab.lua"

if [ "$verify" -eq 1 ]; then
    echo "verifying $run/lab.lua with $bin ($version)"
    exec "$bin" --verify-config -c "$run/lab.lua"
fi

# Refuse to run inside a Wayland/X session: the lab needs its own VT.
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
    die "run this from a text console (Ctrl+Alt+F3), not inside a graphical session. Use --verify here."
fi
case "$(tty 2>/dev/null)" in
    /dev/tty[0-9]*) ;;
    *) die "not on a virtual console (tty is '$(tty 2>/dev/null)')" ;;
esac

ulimit -c unlimited 2>/dev/null
export HYPRLAND_TRACE=1

echo "lab run $run_id"
echo "  $bin ($version) via $launcher, blank=$blank, hold=${hold}s"
echo "  logs: $run"
echo "  switch back to the desktop with Ctrl+Alt+F2 once the screens come back"

start=$(date +%s)
case "$launcher" in
    bare)
        "$bin" -c "$run/lab.lua" > "$run/stdout.log" 2>&1
        rc=$?
        ;;
    start-hyprland)
        "$bindir/start-hyprland" --path "$bin" -- -c "$run/lab.lua" > "$run/stdout.log" 2>&1
        rc=$?
        ;;
esac
end=$(date +%s)

# Rescue the compositor log before anything clears $XDG_RUNTIME_DIR.
rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr"
sig=$(cat "$run/sig" 2>/dev/null)
if [ -n "$sig" ] && [ -f "$rt/$sig/hyprland.log" ]; then
    cp -f "$rt/$sig/hyprland.log" "$run/hyprland.log"
else
    newest=$(ls -td "$rt"/*/ 2>/dev/null | head -1)
    [ -n "$newest" ] && [ -f "$newest/hyprland.log" ] && cp -f "$newest/hyprland.log" "$run/hyprland.log"
fi
cp -f "$HOME"/.cache/hyprland/hyprlandCrashReport*.txt "$run/" 2>/dev/null
# Only keep crash reports newer than this run.
find "$run" -maxdepth 1 -name 'hyprlandCrashReport*.txt' ! -newer "$run/meta.txt" -delete 2>/dev/null

all_on() { jq -e 'type == "array" and length > 0 and all(.[]; .dpmsStatus == true)' "$1" >/dev/null 2>&1; }
all_off() { jq -e 'type == "array" and length > 0 and all(.[]; .dpmsStatus == false)' "$1" >/dev/null 2>&1; }

verdict="CRASH rc=$rc"
if [ -f "$run/after.json" ] && all_on "$run/after.json"; then
    if [ -f "$run/during.json" ] && all_off "$run/during.json"; then
        verdict="PASS"
    else
        verdict="PASS-BUT-NO-BLANK (outputs never read dpmsStatus=false; see during.json)"
    fi
elif [ -f "$run/after.json" ]; then
    verdict="FAIL outputs not all on after unblank (see after.json)"
fi

{
    echo "$verdict"
    echo "exit code $rc after $((end - start))s"
    echo
    cat "$run/meta.txt"
    echo
    echo "--- probe.log ---"
    cat "$run/probe.log" 2>/dev/null || echo "(probe never ran)"
    echo
    echo "--- hyprland.log tail ---"
    tail -40 "$run/hyprland.log" 2>/dev/null || echo "(no compositor log rescued)"
    echo
    echo "--- stdout.log tail ---"
    tail -20 "$run/stdout.log" 2>/dev/null
} > "$run/result.txt"

echo
echo "$verdict (exit $rc, $((end - start))s)"
echo "details: $run/result.txt"
case "$verdict" in PASS*) exit 0 ;; *) exit 1 ;; esac
