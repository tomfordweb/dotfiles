;; cyberdream — eww widgets: desktop calendar + weather + system monitor (bg layer),
;; control center (overlay).
;; Styles: theme.scss (sass, rice palette) -> eww.css. Never add an
;; eww.scss here — eww would prefer it and can't resolve the rice import.

;; ── polls ────────────────────────────────────────────────────────────
(defpoll volume :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2*100)}' || echo 0")
(defpoll brightness :interval "2s"
  "brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d % || echo 100")
(defpoll wifi-on :interval "5s"
  "nmcli radio wifi 2>/dev/null | grep -q enabled && echo true || echo false")
(defpoll bt-on :interval "5s"
  "bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo true || echo false")
;; rice (glass) vs pro (flat presentation) desktop mode — bin/rice-mode.
;; Polled, not deflisten, so nothing breaks if the state file is absent;
;; rice-mode also pushes an immediate `eww update` on toggle.
(defpoll rice-mode :interval "3s" :initial "rice"
  "rice-mode get 2>/dev/null || echo rice")
(defpoll now-playing :interval "2s"
  "playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null || echo ''")

;; Today, for the calendar selection. Without it the widget keeps the day it
;; was created on (no midnight rollover) and a stray click moves the
;; selection for good; bound to this, it returns to today on the next change.
(defpoll today :interval "60s" :initial '{"d":1,"m":1,"y":2026}'
  "date '+{\"d\":%-d,\"m\":%-m,\"y\":%Y}'")

;; ── ghosted desktop calendar ─────────────────────────────────────────
;; :namespace "eww-desk" is what the glass-eww-desk blur layer rule in
;; hyprland.lua matches; calendar and sysmon share width + right edge.
(defwindow calendar-ghost
  :monitor 0
  :stacking "bg"
  :namespace "eww-desk"
  :focusable false
  :exclusive false
  :geometry (geometry :anchor "top right" :x "32px" :y "72px"
                      :width "400px" :height "320px")
  (box :class "cal-ghost ${rice-mode == 'pro' ? 'flat' : ''}" :orientation "v"
    (calendar :class "cal" :day {today.d} :month {today.m} :year {today.y})))

;; ── desktop weather ──────────────────────────────────────────────────
;; scripts/weather: Open-Meteo, location from the machine-local
;; ~/.config/rice/weather.json. No location or no data yet -> ok=false and
;; the panel is not drawn at all.
(defpoll weather :interval "15m" :initial '{"ok":false,"hours":[],"days":[]}'
  "~/.config/eww/scripts/weather")

(defwindow weather
  :monitor 0
  :stacking "bg"
  :namespace "eww-desk"
  :focusable false
  :exclusive false
  :geometry (geometry :anchor "top right" :x "32px" :y "408px" :width "400px")
  (box :class "wx ${rice-mode == 'pro' ? 'flat' : ''}" :orientation "v"
       :space-evenly false :spacing 14 :visible {weather.ok}

    (box :space-evenly false :spacing 14
      (label :class "wx-icon" :valign "center" :text {weather.icon})
      (box :orientation "v" :space-evenly false :valign "center" :hexpand true
        (label :class "wx-temp" :xalign 0 :text "${weather.temp}°")
        (label :class "wx-text" :xalign 0 :text {weather.text}))
      (box :orientation "v" :space-evenly false :valign "center" :spacing 2
        (label :class "wx-place" :xalign 1 :text {weather.name})
        (label :class "wx-meta" :xalign 1
               :text "feels ${weather.feels}°  󰁝 ${weather.hi}°  󰁅 ${weather.lo}°")
        (label :class "wx-meta" :xalign 1
               :text "󰖝 ${weather.wind} mph  󰖎 ${weather.humidity}%")))

    (box :class "wx-hours" :homogeneous true
      (for hour in {weather.hours}
        (box :orientation "v" :space-evenly false :spacing 3
          (label :class "wx-meta" :text {hour.time})
          (label :class "wx-hour-icon" :text {hour.icon})
          (label :text "${hour.temp}°"))))

    (box :class "wx-days" :orientation "v" :space-evenly false :spacing 5
      (for day in {weather.days}
        (box :space-evenly false :spacing 10
          (label :class "wx-day" :xalign 0 :width 40 :text {day.day})
          (label :class "wx-day-icon" :width 24 :text {day.icon})
          (label :class "wx-meta" :xalign 0 :hexpand true :truncate true :text {day.text})
          (label :class "wx-rain" :xalign 1 :width 52
                 :text {day.rain >= 10 ? "󰖎 ${day.rain}%" : ""})
          (label :class "wx-meta" :xalign 1 :width 34 :text "${day.lo}°")
          (label :xalign 1 :width 34 :text "${day.hi}°"))))))

;; ── desktop system monitor ───────────────────────────────────────────
;; CPU/RAM load: eww's EWW_CPU / EWW_RAM. Everything else (GPU, network,
;; temps, disks, processes): one JSON line per 2s from scripts/sysmon.
(deflisten sys
  :initial '{"cpu_temp":0,"mem_temp":0,"gpu":{"has":false,"name":"","util":0,"mem_used":"0","mem_total":"0","mem_pct":0,"temp":0,"power":0,"fan":0},"net":{"iface":"","down":0,"up":0,"down_h":"0B/s","up_h":"0B/s"},"disks":[],"procs":[]}'
  "~/.config/eww/scripts/sysmon")

(defwidget sm-head [icon title value ?temp]
  (box :class "sm-head" :space-evenly false
    (label :class "sm-icon" :text icon)
    (label :class "sm-title" :halign "start" :hexpand true :truncate true :text title)
    (label :class "sm-value" :halign "end" :text value)
    (label :class "sm-temp-val" :halign "end" :visible {(temp ?: 0) > 0}
           :text "${temp ?: 0}°F")))

(defwidget sm-graph [value kind ?dynamic]
  (box :class "sm-plot ${kind}"
    (graph :class "sm-graph" :height 46 :hexpand true
           :value value :min 0 :max 100 :dynamic {dynamic ?: false}
           :thickness 2 :time-range "120s" :line-style "round")))

;; Load graph with the temperature trace drawn over it. Load runs 0-100 %,
;; the trace 32-212 °F (freezing to boiling) on the same height; the trace
;; takes the colour of the °F figure in the header, which is the only legend it needs. A reading of 0 means
;; the host has no such sensor: figure and trace both hide.
(defwidget sm-graph-temp [value temp kind]
  (box :class "sm-plot ${kind}"
    (overlay :hexpand true
      (graph :class "sm-graph" :height 46 :hexpand true
             :value value :min 0 :max 100
             :thickness 2 :time-range "120s" :line-style "round")
      (graph :class "sm-graph-temp" :visible {temp > 0}
             :value temp :min 32 :max 212
             :thickness 1.5 :time-range "120s" :line-style "round"))))

(defwindow sysmon
  :monitor 0
  :stacking "bg"
  :namespace "eww-desk"
  :focusable false
  :exclusive false
  ;; y = weather's y (408) + its height (345) + 16px gap
  :geometry (geometry :anchor "top right" :x "32px" :y "769px" :width "400px")
  (box :class "sm ${rice-mode == 'pro' ? 'flat' : ''}" :orientation "v"
       :space-evenly false :spacing 14

    (box :orientation "v" :space-evenly false :spacing 6
      (sm-head :icon "󰻠" :title "cpu"
               :value "${round(EWW_CPU.avg, 0)}%" :temp {sys.cpu_temp})
      (sm-graph-temp :kind "cpu" :value {EWW_CPU.avg} :temp {sys.cpu_temp})
      (box :class "sm-cores" :spacing 3
        (for core in {EWW_CPU.cores}
          (progress :class "sm-core" :orientation "v" :flipped true
                    :value {core.usage}))))

    (box :orientation "v" :space-evenly false :spacing 6
      (sm-head :icon "󰍛" :title "memory"
               :value "${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GiB"
               :temp {sys.mem_temp})
      (sm-graph-temp :kind "mem" :value {EWW_RAM.used_mem_perc} :temp {sys.mem_temp}))

    (box :orientation "v" :space-evenly false :spacing 6 :visible {sys.gpu.has}
      (sm-head :icon "󰢮" :title {sys.gpu.name}
               :value "${sys.gpu.util}%  ${sys.gpu.power}W" :temp {sys.gpu.temp})
      (sm-graph-temp :kind "gpu" :value {sys.gpu.util} :temp {sys.gpu.temp})
      (box :class "sm-row" :space-evenly false :spacing 10
        (label :class "sm-key" :text "vram")
        (progress :class "sm-bar gpu" :hexpand true :valign "center"
                  :value {sys.gpu.mem_pct})
        (label :class "sm-num" :text "${sys.gpu.mem_used} / ${sys.gpu.mem_total} GiB")))

    (box :orientation "v" :space-evenly false :spacing 6
      (sm-head :icon "󰈀" :title {sys.net.iface != "" ? sys.net.iface : "offline"}
               :value "󰁅 ${sys.net.down_h}  󰁝 ${sys.net.up_h}")
      (box :spacing 8
        (sm-graph :kind "down" :value {sys.net.down} :dynamic true)
        (sm-graph :kind "up" :value {sys.net.up} :dynamic true)))

    (box :orientation "v" :space-evenly false :spacing 5
      (for disk in {sys.disks}
        (box :class "sm-row" :space-evenly false :spacing 10
          (label :class "sm-mount" :xalign 0 :width 120 :truncate true :text {disk.mount})
          (progress :class "sm-bar ${disk.pct > 90 ? 'hot' : ''}" :hexpand true
                    :valign "center" :value {disk.pct})
          (label :class "sm-num" :xalign 1 :width 96
                 :text "${disk.used} / ${disk.total}"))))

    (box :class "sm-table" :orientation "v" :space-evenly false :spacing 3
      (box :class "sm-th" :space-evenly false
        (label :xalign 0 :hexpand true :text "process")
        (label :xalign 1 :width 64 :text "cpu %")
        (label :xalign 1 :width 72 :text "mem"))
      (for proc in {sys.procs}
        (box :class "sm-tr" :space-evenly false
          (label :xalign 0 :hexpand true :truncate true :text {proc.name})
          (label :class "sm-num" :xalign 1 :width 64 :text {proc.cpu})
          (label :class "sm-num" :xalign 1 :width 72 :text {proc.mem}))))))

;; ── control center (toggled from the waybar chip) ────────────────────
;; Open via `eww open-many --toggle cc-closer control-center` so the
;; click-catcher below comes along. :focusable must stay false — an
;; exclusive keyboard grab from an overlay layer can wedge the session.
(defwindow control-center
  :monitor 0
  :stacking "overlay"
  :focusable false
  :geometry (geometry :anchor "top right" :x "16px" :y "58px" :width "360px")
  (box :class "cc ${rice-mode == 'pro' ? 'flat' : ''}" :orientation "v" :spacing 12
    (label :class "cc-title" :halign "start" :text "control center")
    (box :class "cc-card" :orientation "v" :spacing 6
      (label :class "cc-sub" :halign "start" :text "󰕾  volume")
      (scale :class "cc-slider" :min 0 :max 101 :value volume
             :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"))
    (box :class "cc-card" :orientation "v" :spacing 6
      (label :class "cc-sub" :halign "start" :text "󰃟  brightness")
      (scale :class "cc-slider" :min 5 :max 101 :value brightness
             :onchange "brightnessctl set {}% 2>/dev/null"))
    (box :class "cc-toggles" :spacing 8 :homogeneous true
      (button :class "cc-toggle ${wifi-on == 'true' ? 'on' : ''}"
              :onclick "nmcli radio wifi ${wifi-on == 'true' ? 'off' : 'on'}" "󰤨")
      (button :class "cc-toggle ${bt-on == 'true' ? 'on' : ''}"
              :onclick "bluetoothctl power ${bt-on == 'true' ? 'off' : 'on'}" "󰂯")
      (button :class "cc-toggle"
              :onclick "eww close control-center cc-closer && hyprlock &" "󰌾"))
    (label :class "cc-media" :halign "start" :truncate true
           :visible {now-playing != ""} :text now-playing)
    (box :class "cc-power" :spacing 8 :homogeneous true
      (button :class "cc-danger" :onclick "systemctl suspend" "󰤄")
      (button :class "cc-danger" :onclick "systemctl reboot" "󰜉")
      (button :class "cc-danger" :onclick "systemctl poweroff" "󰐥"))))

;; ── click-away catcher for the control center ────────────────────────
;; eww has no native close-on-outside-click; this invisible full-screen
;; window sits under the control center (top layer vs overlay) and closes
;; both on any stray click.
(defwindow cc-closer
  :monitor 0
  :stacking "fg"
  :focusable false
  :exclusive false
  :geometry (geometry :anchor "top left" :width "100%" :height "100%")
  (eventbox :onclick "eww close control-center cc-closer" (box)))
